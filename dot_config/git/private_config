[commit]
  gpgsign = true

[tag]
  gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  allowedSignersFile = ~/.config/git/allowed_signers

[init]
  defaultBranch = main

[fetch]
  prune = true

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[rebase]
  autoStash = true
